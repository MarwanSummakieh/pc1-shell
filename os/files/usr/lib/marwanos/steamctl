#!/usr/bin/env python3
"""One native/legacy Steam contract for discovery, launch and shutdown."""
import argparse
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import time


def libraries(home):
    home = Path(home)
    roots = [home / ".local/share/Steam", home / ".steam/steam",
             home / ".var/app/com.valvesoftware.Steam/.local/share/Steam"]
    found = [home / "Games/SteamLibrary/steamapps"]
    for root in roots:
        found.append(root / "steamapps")
        config = root / "steamapps/libraryfolders.vdf"
        try:
            source = config.read_text(errors="replace")
        except OSError:
            continue
        # Modern libraryfolders uses path fields. JSON string escaping matches
        # Valve's backslash/quote escapes for Linux paths without splitting spaces.
        for match in re.finditer(r'"path"\s+("(?:[^"\\]|\\.)*")', source, re.I):
            try:
                value = json.loads(match.group(1))
            except ValueError:
                continue
            if isinstance(value, str) and value.startswith("/") and not any(c in value for c in "\0\r\n\t"):
                found.append(Path(value) / "steamapps")
    seen = set()
    for path in found:
        path = path.resolve()
        if path not in seen:
            seen.add(path)
            yield path


def command(arguments):
    # Steam's CEF controls must expose focused editors to the system keyboard.
    arguments = ["-cef-force-accessibility", *arguments]
    if shutil.which("steam"):
        return ["steam", *arguments]
    if shutil.which("flatpak"):
        return ["flatpak", "run", "com.valvesoftware.Steam", *arguments]
    raise RuntimeError("Steam is not installed")


def steam_processes():
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid == os.getuid() and (proc / "comm").read_text().strip() in {"steam", "steamwebhelper"}:
                yield int(proc.name), (proc / "stat").read_text().rsplit(")", 1)[1].split()[19]
        except (OSError, IndexError):
            continue


def stop():
    if shutil.which("steam"):
        records = list(steam_processes())
        try:
            subprocess.run(["steam", "-shutdown"], timeout=10, check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            pass
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline and list(steam_processes()):
            time.sleep(.1)
        # Check process start times again so a recycled PID is never signalled.
        current = set(steam_processes())
        for pid, started in records:
            if (pid, started) in current:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
    if shutil.which("flatpak"):
        subprocess.run(["flatpak", "kill", "com.valvesoftware.Steam"], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("action", choices=["libraries", "launch", "signin", "background", "stop"])
    parser.add_argument("appid", nargs="?")
    parser.add_argument("--home", default=str(Path.home()))
    args = parser.parse_args()
    if args.action == "libraries":
        for path in libraries(args.home):
            sys.stdout.buffer.write(os.fsencode(path) + b"\0")
    elif args.action == "stop":
        stop()
    else:
        if args.action == "launch" and (not args.appid or not args.appid.isdigit()):
            parser.error("launch requires a numeric application ID")
        argv = command(["-silent"] if args.action == "background" else ["-gamepadui"])
        if args.action == "launch":
            argv.append("steam://rungameid/" + args.appid)
        # Keep the console's HOME and remembered Steam login for every local user.
        os.execvp(argv[0], argv)


if __name__ == "__main__":
    main()
